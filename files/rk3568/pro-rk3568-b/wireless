config wifi-device 'radio0'
        option type 'mac80211'
        option path 'platform/fe000000.mmc/mmc_host/mmc1/mmc1:0001/mmc1:0001:1'
        option band '2g'
        option channel 'auto'
        option htmode 'HE20'
        option country 'CN'
        option disabled '0'

config wifi-iface 'default_radio0'
        option device 'radio0'
        option network 'lan'
        option mode 'ap'
        option ssid 'OpenWrt-2.4G'
        option encryption 'none'

config wifi-device 'radio1'
        option type 'mac80211'
        option path 'platform/fe000000.mmc/mmc_host/mmc1/mmc1:0001/mmc1:0001:1'
        option band '5g'
        option channel 'auto'
        option htmode 'HE80'
        option country 'CN'
        option disabled '0'

config wifi-iface 'default_radio1'
        option device 'radio1'
        option network 'lan'
        option mode 'ap'
        option ssid 'OpenWrt-5G'
        option encryption 'none'
